{
  "$id": "https://captain.internal/schemas/resume_input.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One answer to one interrupt (mirrors an AG-UI RunAgentInput.resume entry).",
  "properties": {
    "actor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actor"
    },
    "interrupt_id": {
      "title": "Interrupt Id",
      "type": "string"
    },
    "payload": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Payload"
    },
    "status": {
      "default": "resolved",
      "enum": [
        "resolved",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "interrupt_id"
  ],
  "title": "ResumeInput",
  "type": "object"
}
